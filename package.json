{
  "name": "background-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Looping animated backgrounds and stream overlays (chat, text blocks and borders) with transparency, sold in packs, built with Remotion Studio",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "render:mp4": "tsx scripts/render.ts --format mp4",
    "render:webm": "tsx scripts/render.ts --format webm",
    "render:gif": "tsx scripts/render.ts --format gif",
    "render:mov": "tsx scripts/render.ts --format mov",
    "render:png": "tsx scripts/render.ts --format png",
    "render:pack": "node --import tsx scripts/pack.ts",
    "zip:pack": "tsx scripts/zip-pack.ts",
    "validate:pack": "tsx scripts/validate-pack.ts",
    "ship:pack": "node --import tsx scripts/ship-pack.ts",
    "listing:page": "tsx scripts/listing-page.ts",
    "reference": "tsx scripts/reference-search.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:quick": "tsx --test tests/kinds.test.ts tests/settings.test.ts tests/sizes.test.ts tests/schema-descriptions.test.ts tests/backgrounds.test.ts tests/webgl.test.ts tests/wuthering-waves.test.ts tests/watercolor.test.ts",
    "test:kit": "tsx scripts/test-kit.ts",
    "mutate": "tsx scripts/mutate.ts",
    "validate:exports": "tsx scripts/validate-exports.ts",
    "stills": "tsx scripts/stills.ts",
    "qa:kit": "tsx scripts/qa-kit.ts",
    "clean": "tsx scripts/clean.ts",
    "ornaments:report": "tsx scripts/ornaments-report.ts",
    "build:tokyo": "node ~/obsidian/AI/scripts/render-slot.ts run -- /Volumes/Sandisk/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/create-tokyo-city.py -- --output-dir public/tokyo/organic",
    "preview:tokyo": "tsx scripts/tokyo-preview.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/zod-types": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529",
    "three": "0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "eslint": "9.39.1",
    "pngjs": "7.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "engines": {
    "node": ">=22"
  }
}
